---
import { getCollection } from 'astro:content';
import Project from '../../layouts/Project.astro';
import ProjectMetrics from '../../components/ProjectMetrics.astro';
import ProjectSteps from '../../components/ProjectSteps.astro';
import ProjectTakeaway from '../../components/ProjectTakeaway.astro';
import NextProject from '../../components/NextProject.astro';

export async function getStaticPaths() {
    const projects = await getCollection('projects');

    return projects.map((project, index) => {
        // Calculate next project in the list or go back to first
        const nextIndex = (index + 1) % projects.length;
        const nextProject = projects[nextIndex];

        return {
            params: { slug: project.id },
            props: { 
                project,
                nextProject: {
                    title: nextProject.data.title,
                    slug: nextProject.id
                }
            }
        };
    });
}

const { project, nextProject } = Astro.props;
const p = project.data;
---

<Project title={`${project.data.title} |`}>
	<!-- header -->
    <div class="bg-accent-pale px-6 pt-3 pb-6 flex flex-col gap-4">
        <div class="flex justify-end">
            <a href="/projects" class="text-xs text-neutral-400 hover:text-neutral-700 transition">
                ← Projets
            </a>
        </div>

        <div class="space-y-2.5">
            <div class="flex items-center gap-2 text-[10px] font-semibold text-accent uppercase tracking-wider">
                <span>{project.data.type ?? 'Projet universitaire'}</span>
                <span>·</span>
                <span>{project.data.date}</span>
            </div>

            <!-- stack tags -->
            <div class="flex flex-wrap gap-1.5">
                {project.data.stack.map((item, idx) => (
                <span class={`text-[10px] font-medium px-2.5 py-0.5 rounded-md ${idx === project.data.stack.length - 1 ? 'bg-accent text-white' : 'bg-white text-neutral-600 border border-neutral-200/50'}`}>
                    {item}
                </span>
                ))}
            </div>

            <h1 class="font-serif text-3xl font-bold text-noir pt-1">
                {project.data.title.slice(0, 5)}<em class="text-accent italic font-normal">{project.data.title.slice(5)}</em>
            </h1>

            {p.desc && (
                <p class="text-xs text-neutral-500 leading-relaxed">
                    {p.desc}
                </p>
            )}
        </div>
    </div>

    <!-- body -->
    <div class="px-6 py-5 flex flex-col gap-6">
        
        <!-- metrics -->
        {project.data.metrics && (
            <ProjectMetrics metrics={project.data.metrics} />
        )}

        <!-- visual galery -->
        {p.images && p.images.length > 0 && (
            <section class="space-y-3">
                <div class="flex items-center justify-between text-[10px] uppercase tracking-wider font-semibold text-neutral-400">
                    <span>Visuels</span>
                    <span id="gallery-counter">1 / {p.images.length}</span>
                </div>

                <div id="gallery-carousel" 
                    class="flex gap-3 overflow-x-auto scrollbar-hide pb-2 snap-x snap-mandatory -mx-6 px-6 scroll-smooth">
                    {p.images.map((img) => (
                        <img
                            src={img.src}
                            alt={img.alt}
                            class="w-56 h-36 shrink-0 rounded-2xl object-cover snap-start"
                        />
                    ))}
                </div>

                <div class="flex justify-center items-center gap-1">
                    {p.images.map((_, i) => (
                        <span
                            class={`gallery-dot rounded-full bg-accent transition-all duration-300 ${
                                i === 0 ? 'w-3.5 h-1' : 'w-1 h-1 bg-accent/30'
                            }`}
                            data-index={i}
                        ></span>
                    ))}
                </div>
            </section>
        )}

        <!-- approach / steps -->
        {p.approach && <ProjectSteps steps={p.approach} />}

        <!-- what I learned -->
        {p.learned && <ProjectTakeaway text={p.learned} />}

        <!-- action buttons -->
        <div class="flex flex-col gap-2 pt-2">
            <a 
                href={project.data.websiteLink ?? "#"} 
                class="w-full py-3.5 px-5 rounded-2xl bg-noir text-white text-xs font-semibold flex items-center justify-between hover:opacity-90 transition"
            >
                <span>Voir le site</span>
                <span>→</span>
            </a>
            <a 
                href={project.data.githubLink ?? "#"} 
                target="_blank" 
                rel="noreferrer"
                class="w-full py-3.5 px-5 rounded-2xl bg-white border border-neutral-200 text-noir text-xs font-semibold text-center hover:bg-neutral-50 transition"
            >
                GitHub
            </a>
        </div>

        {nextProject && (
            <NextProject 
                title={nextProject.title} 
                slug={nextProject.slug} 
            />
        )}

    </div>
</Project>

<script>
    const carousel = document.getElementById('gallery-carousel');
    const dots = document.querySelectorAll('.gallery-dot');
    const counter = document.getElementById('gallery-counter');

    const total = carousel?.children.length ?? 0;

    carousel?.addEventListener('scroll', () => {
        const scrollLeft = carousel.scrollLeft;
        const cardWidth = carousel.firstElementChild?.clientWidth ?? 0;
        const current = Math.round(scrollLeft / (cardWidth + 12)); // 12 = gap-3

        dots.forEach((dot, i) => {
            const el = dot as HTMLElement;
            if (i === current) {
                el.classList.remove('w-1', 'bg-accent/30');
                el.classList.add('w-3.5', 'bg-accent');
            } else {
                el.classList.remove('w-3.5', 'bg-accent');
                el.classList.add('w-1', 'bg-accent/30');
            }
        });

        if (counter) counter.textContent = `${current + 1} / ${total}`;
    });
</script>