---
interface Props {
  stat: string;
  title: string;
  body: string;
}

const { stat, title, body } = Astro.props;
---

<div class="bg-neutral-50 border border-neutral-200 rounded-2xl p-4 flex gap-3.5 items-start">
  <span class="font-serif text-3xl font-bold text-accent shrink-0 leading-none pt-0.5">
    {stat}
  </span>
  <div class="flex flex-col gap-1">
    <h3 class="text-xs font-bold text-noir">
      {title}
    </h3>
    <p class="text-[11px] text-neutral-600 leading-relaxed">
      {body}
    </p>
  </div>
</div>