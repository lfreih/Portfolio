---
interface Metric {
    value: string;
    label: string;
}

interface Props {
    metrics: Metric[];
}

const { metrics } = Astro.props;
---

<div class="grid grid-cols-2 divide-x divide-neutral-200 border-y border-neutral-200 py-4 my-6">
    <div class="flex flex-col gap-4 pr-4">
        {metrics.slice(0, 2).map((m) => (
            <div>
                <p class="font-serif text-2xl font-bold text-noir">
                    {m.value.slice(0, -1)}<span class="text-accent">{m.value.slice(-1)}</span>
                </p>
                <p class="text-[11px] text-neutral-400 mt-0.5">{m.label}</p>
            </div>
        ))}
    </div>

    <div class="flex flex-col gap-4 pl-4">
        {metrics.slice(2, 4).map((m) => (
            <div>
                <p class="font-serif text-2xl font-bold text-noir">{m.value}</p>
                <p class="text-[11px] text-neutral-400 mt-0.5">{m.label}</p>
            </div>
            ))}
    </div>
</div>