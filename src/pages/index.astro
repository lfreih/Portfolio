---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

import HeroProfile from '../components/HeroProfile.astro';
import FeaturedCard from '../components/FeaturedCard.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter((p) => p.data.une);

const skills = ['Laravel', 'BDD', 'Vue.js', 'UI/UX'];
---

<Base title="Accueil |">
	<!-- Haut de page -->
  	<HeroProfile skills={skills} />

	<!-- Section À la une -->
	<section class="bg-accent-pale px-6 py-6 flex flex-col gap-4">
		<div class="flex items-center justify-between">
			<h2 class="font-serif text-xl font-bold text-noir">
				À la une
			</h2>
			<a href="/projects" class="text-xs text-accent font-medium hover:underline">
				Tout voir →
			</a>
		</div>

		<!-- Carrousel horizontal -->
		<div id="carousel-une" 
		  	class="flex gap-4 overflow-x-auto snap-x snap-mandatory -mx-6 px-6 scroll-smooth scrollbar-hide"
		>
			{featuredProjects.map((p, index) => (
				<FeaturedCard
					title={p.data.title}
					stack={p.data.stack}
					slug={p.id}
					desc={p.data.desc}
					bgColor={index % 2 === 0 ? "bg-[#9eb3d2]" : "bg-[#b4a6c9]"}
				/>
			))}
		</div>

		<!-- Indicateurs de carrousel -->
		<div id="dots-une" class="flex justify-center items-center gap-1.5 pt-1">
			{featuredProjects.map((_, i) => (
				<span 
					class={`carousel-une-dot rounded-full bg-accent transition-all duration-300 ${
						i === 0 ? 'w-4 h-1.5' : 'w-1.5 h-1.5 opacity-30'
					}`}
					data-index={i}
				></span>
			))}
		</div>
	</section>

</Base>

<script>
	const carousel = document.getElementById('carousel-une');
	const dots = document.querySelectorAll('.carousel-une-dot');

	carousel?.addEventListener('scroll', () => {
		const scrollLeft = carousel.scrollLeft;
		const cardWidth = carousel.firstElementChild?.clientWidth ?? 0;
		const current = Math.round(scrollLeft / (cardWidth + 16));

		dots.forEach((dot, i) => {
		const el = dot as HTMLElement;
		if (i === current) {
			el.classList.remove('w-1.5', 'opacity-30');
			el.classList.add('w-4');
		} else {
			el.classList.remove('w-4');
			el.classList.add('w-1.5', 'opacity-30');
		}
		});
	});
</script>