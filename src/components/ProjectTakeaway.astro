---
interface Props {
    text: string;
}

const { text } = Astro.props;
---

<div class="relative bg-neutral-50 rounded-2xl p-4 pl-5 border-l-4 border-accent space-y-1.5">
    <h2 class="text-[10px] uppercase tracking-wider font-semibold text-neutral-400">
        Ce que j'en retiens
    </h2>
    <p class="text-xs text-neutral-700 italic leading-relaxed">
        {text}
    </p>
</div>