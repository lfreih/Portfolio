---
interface Props {
    title: string;
    slug: string;
}

const { title, slug } = Astro.props;
---

<div class="pt-6 mt-6 border-t border-neutral-100 flex items-center justify-between">
    <div class="space-y-0.5">
        <span class="text-[11px] text-neutral-400 block font-normal">
            Projet suivant
        </span>
        <a 
            href={`/projects/${slug}`} 
            class="font-serif text-base font-bold text-noir hover:text-accent transition-colors"
        >
            {title}
        </a>
    </div>

    <a 
        href={`/projects/${slug}`} 
        aria-label={`Aller au projet suivant : ${title}`}
        class="text-accent text-lg font-medium hover:translate-x-1 transition-transform"
    >
        →
    </a>
</div>