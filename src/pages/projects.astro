---
import { getCollection } from 'astro:content'

import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectListCard from '../components/ProjectListCard.astro';

const allProjects = await getCollection('projects');

const filters = ['Tous', 'Web', 'UI/UX', 'API', 'Design', 'Logiciel', 'Jeu'];

const pastelColors = [
    'bg-[#9db2c9]', 
    'bg-[#b1a4bc]', 
    'bg-[#9bb8a6]', 
    'bg-[#bec29e]'  
];
---

<Base title="Mes réalisations |">
    <div class="px-6 py-6 space-y-6">
        
        <!-- page title -->
        <header class="space-y-1">
            <h1 class="font-serif text-3xl font-bold text-noir leading-tight">
                Mes <span class="text-accent italic font-normal">réalisations</span>
            </h1>
        </header>

        <!-- filter nav -->
        <div class="flex flex-no-wrap overflow-auto scrollbar-hide gap-2" id="filter-container">
            {filters.map((filter, index) => (
                <button 
                    type="button"
                    data-filter={filter.toLowerCase()}
                    class={`filter-btn px-3 py-1.5 rounded-full text-xs font-medium border transition cursor-pointer ${
                        index === 0 
                        ? 'active-filter bg-noir text-white border-noir' 
                        : 'bg-white text-neutral-500 border-neutral-200 hover:border-neutral-400'
                    }`}
                >
                    {filter}
                </button>
            ))}
        </div>

        <!-- project cards list -->
        <div class="flex flex-col gap-3.5 mb-3" id="projects-list">
            {allProjects.map((p, index) => {
                return (
                    <ProjectListCard
                        title={p.data.title}
                        desc={p.data.desc ?? 'Description courte du projet et de son contexte.'}
                        slug={p.id}
                        tags={p.data.stack}
                        searchableTags={[...p.data.stack, ...(p.data.tag ?? [])]}
                        bgColor={pastelColors[index % pastelColors.length]}
                    />
                );
            })}
        </div>

    </div>
</Base>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');

    buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
            const selected = btn.dataset.filter ?? 'tous';

            // update active status
            buttons.forEach((b) => {
                b.classList.remove('bg-noir', 'text-white', 'border-noir');
                b.classList.add('bg-white', 'text-neutral-500', 'border-neutral-200');
            });

            btn.classList.remove('bg-white', 'text-neutral-500', 'border-neutral-200');
            btn.classList.add('bg-noir', 'text-white', 'border-noir');

            // filter list elements
            cards.forEach((card) => {
                const cardTags = card.dataset.tags ?? '';

                if (selected === 'tous') {
                    card.classList.remove('hidden');
                } else if (selected === 'ui/ux') {
                    const match = cardTags.includes('ui') || cardTags.includes('ux') || cardTags.includes('ui/ux');
                    card.classList.toggle('hidden', !match);
                } else {
                    card.classList.toggle('hidden', !cardTags.includes(selected));
                }
            });
        });
    });
</script>